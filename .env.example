
# Application
APP_NAME=BizPilot AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=bizpilot-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Data ingestion
MAX_UPLOAD_SIZE_MB=20
